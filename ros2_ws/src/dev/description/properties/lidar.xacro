<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================== Lidar properties =========================== -->
  <!-- ================== Laser ================== -->
  <!-- ========= Dimensions ========= -->
  <xacro:property name="laser_frame_size_xy" value="0.05" />
  <xacro:property name="laser_frame_size_z" value="0.04" />

  <!-- ========= Joint offsets ========= -->
  <xacro:property name="chassis_to_laser_frame_joint_x" value="0.15" />
  <xacro:property name="chassis_to_laser_frame_joint_y" value="0" />
  <xacro:property name="chassis_to_laser_frame_joint_z" value="0.17" />

  <!-- ========= Material ========= -->
  <xacro:property name="laser_frame_material" value="orange" />

  <!-- ========= Inertial ========= -->
  <xacro:property name="laser_frame_mass" value="0.5" />

  <!-- ========= Gazebo ========= -->
  <xacro:property name="laser_frame_gazebo_material" value="Gazebo/Orange" />

  <!-- ========= Sensor ========= -->
  <xacro:property name="laser_visualize" value="true" />
  <xacro:property name="laser_update_rate" value="5" />
  <xacro:property name="laser_samples" value="360" />
  <xacro:property name="laser_min_angle" value="${-pi}" />
  <xacro:property name="laser_max_angle" value="${pi}" />
  <xacro:property name="laser_range_min" value="0.15" />
  <xacro:property name="laser_range_max" value="6" />
  <xacro:property name="laser_topic" value="scan" />
  <xacro:property name="laser_output_type" value="LaserScan" />

</robot>